# FerixRG backend production environment only.
# Keep this file server-side. Never expose it to the frontend or commit a populated copy.

NODE_ENV=production
PORT=5010

# Neon PostgreSQL: pooled URL for runtime; direct URL for migrations.
DATABASE_URL=postgresql://<neon-pooled-user>:<password>@<neon-pooler-host>/<database>?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://<neon-direct-user>:<password>@<neon-direct-host>/<database>?sslmode=require

# Generate unique values for this deployment.
JWT_SECRET=<new-long-random-ferixrg-secret>
STORE_CONNECTION_ENCRYPTION_KEY=<new-32-byte-aes-key-base64-or-64-hex>

# Public origin used by backend links, OAuth, and CORS.
FERIXRG_APP_ORIGIN=https://ferixrg.ferixas.com

# Cloudflare Workers AI; fill with real values to enable live AI.
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_AI_MODEL=@cf/meta/llama-3.2-3b-instruct

# Transactional email; fill with real values to enable email delivery.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Shopify; fill with real values only when Shopify authorization is enabled.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=https://ferixrg.ferixas.com/api/store-connections/shopify/callback

# Existing OAuth backend settings; fill only when OAuth login is enabled.
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
OWNER_NAME=

# Optional legacy Forge provider; leave empty when using Cloudflare Workers AI.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Reserved for future two-step verification.
TOTP_ENCRYPTION_KEY=
