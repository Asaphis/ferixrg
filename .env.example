# FerixRG production environment template.
# Copy to .env on the server, replace every placeholder, chmod 600 .env,
# and never commit the populated file.

NODE_ENV=production
PORT=5010

# Neon PostgreSQL: pooled URL for runtime queries, direct URL for migrations.
DATABASE_URL=postgresql://<neon-pooled-user>:<password>@<neon-pooler-host>/<database>?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://<neon-direct-user>:<password>@<neon-direct-host>/<database>?sslmode=require

# Generate unique values for this deployment; do not reuse them elsewhere.
JWT_SECRET=<generate-a-long-random-secret>
STORE_CONNECTION_ENCRYPTION_KEY=<32-random-bytes-base64-or-64-hex-characters>

# Public application/API topology.
FERIXRG_APP_ORIGIN=https://ferixrg.ferixas.com
VITE_API_BASE_URL=https://ferixrgapi.ferixas.com

# Existing OAuth application settings, if Manus OAuth is enabled.
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
OWNER_NAME=

# Cloudflare Workers AI, optional until configured.
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_AI_MODEL=@cf/meta/llama-3.2-3b-instruct

# Transactional email, optional until configured.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Shopify authorization, optional until configured.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Defaults to https://ferixrg.ferixas.com/api/store-connections/shopify/callback
SHOPIFY_REDIRECT_URI=https://ferixrg.ferixas.com/api/store-connections/shopify/callback

# Reserved for the future two-step authenticator implementation.
TOTP_ENCRYPTION_KEY=
