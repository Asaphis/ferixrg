# Frontend build environment only.
# These values are public and are compiled into the browser bundle.
# Never place database URLs, passwords, API tokens, or private keys here.

VITE_API_BASE_URL=https://ferixrgapi.ferixas.com

# Required only when the existing OAuth login is enabled.
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=

# Optional analytics integration.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
